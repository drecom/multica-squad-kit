#!/usr/bin/env bash
# multica-squad-kit-managed
# リーダーが毎回読む、タスク・コメントの差分・PR・CI・実行・区切りの途中を、1 つの JSON で出す。
# 使い方: squad-task-read <タスク> [--since <RFC3339>]
# 終了コード: 0 は JSON を出した、1 はタスクかコメントを読めない、2 は使い方の誤り。
# PR・CI・実行・区切りを読めないときは、その欄を null にして errors に理由を足し、終了コード 0 にする。
set -euo pipefail
here=$(dirname "${BASH_SOURCE[0]}")
source "$here/squad-cli-lib"

usage() {
	echo '使い方: squad-task-read <タスク> [--since <RFC3339>]' >&2
	exit 2
}

# RFC3339 の時刻（Z か時差つき）を、[エポック秒, 小数 9 桁の文字列] にする jq の定義。配列は先頭から比べるので、小数の秒も順序に入る。
ts_def='
def ts:
	(capture("\\.(?<f>[0-9]+)").f // "0") as $f
	| sub("\\.[0-9]+"; "")
	| (if endswith("Z") then fromdateiso8601
	  else capture("^(?<b>.*)(?<s>[+-])(?<h>[0-9]{2}):(?<m>[0-9]{2})$") as $c
		| ($c.b + "Z" | fromdateiso8601) - (if $c.s == "+" then 1 else -1 end) * (($c.h | tonumber) * 3600 + ($c.m | tonumber) * 60)
	  end) as $sec
	| [$sec, (($f + "000000000")[0:9])];'

task=
since=
while (($# > 0)); do
	case $1 in
	--since)
		(($# >= 2)) && [[ -n $2 ]] || usage
		[[ -z $since ]] || usage
		since=$2
		shift 2 ;;
	-*) usage ;;
	*)
		[[ -z $task ]] || usage
		task=$1
		shift ;;
	esac
done
[[ -n $task ]] || usage
if [[ -n $since ]]; then
	[[ $since =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$ ]] || usage
	jq -en --arg s "$since" "$ts_def"' $s | ts | (.[0] | type) == "number"' >/dev/null 2>&1 || usage
fi

errors='[]'
err_file=$(mktemp "${TMPDIR:-/tmp}/squad-task-read.XXXXXX")
trap 'rm -f -- "$err_file"' EXIT

# 読めなかった欄を errors に足す。理由は、読み取りが標準エラーに出した 1 行目にする。
add_error() {
	local field=$1 reason
	reason=$(head -n 1 "$err_file" 2>/dev/null || true)
	[[ -n $reason ]] || reason='読み取りに失敗しました'
	errors=$(jq -c --arg f "$field" --arg r "$reason" '. + [{field: $f, reason: $r}]' <<<"$errors")
}

issue=$(squad_cli_read issue-get "$task" 2>"$err_file") || { cat "$err_file" >&2; echo "タスクを読めません: $task" >&2; exit 1; }
comments_raw=$(squad_cli_read issue-comments "$task" 2>"$err_file") || { cat "$err_file" >&2; echo "タスクのコメントを読めません: $task" >&2; exit 1; }

task_json=$(jq -c '{
	id, identifier, title,
	status,
	labels: [(.labels // [])[] | if type == "object" then .name else . end],
	metadata,
	assignee_type, assignee_id
}' <<<"$issue") || { echo 'タスクを整形できません' >&2; exit 1; }

comments_json_file=$(mktemp "${TMPDIR:-/tmp}/squad-task-read-comments.XXXXXX")
runs_json_file=$(mktemp "${TMPDIR:-/tmp}/squad-task-read-runs.XXXXXX")
trap 'rm -f -- "$err_file" "$comments_json_file" "$runs_json_file"' EXIT
# コメントや実行の一覧は大きくなるので、引数ではなくファイルと標準入力で渡す（引数の長さの上限を避ける）。
jq -c --arg since "$since" "$ts_def"'
	(if $since == "" then null else ($since | ts) end) as $from
	| [.[] | select($from == null or (.created_at | ts) > $from)
		| {id, parent_id, author_type, author_id, created_at, content}]' <<<"$comments_raw" >"$comments_json_file" \
	|| { echo 'コメントを整形できません' >&2; exit 1; }

pr_json=null
ci_json=null
pr_url=$(jq -r '.metadata.pr_url // ""' <<<"$issue")
if [[ -n $pr_url ]]; then
	if [[ $pr_url =~ ^https://github\.com/([^/]+/[^/]+)/pull/([0-9]+)([/?#].*)?$ ]]; then
		repo=${BASH_REMATCH[1]}
		number=${BASH_REMATCH[2]}
		if raw=$(squad_cli_read gh-dependabot-pr "$number" "$repo" 2>"$err_file"); then
			pr_json=$(jq -c --arg url "$pr_url" '{url: $url, state, draft: .isDraft, head_sha: .headRefOid, mergeable}' <<<"$raw") \
				|| { pr_json=null; echo 'PR の応答を整形できません' >"$err_file"; add_error pr; }
		else
			add_error pr
		fi
		if raw=$(squad_cli_read gh-pr-checks "$pr_url" 2>"$err_file"); then
			# StatusContext は、state をそのまま status と conclusion に入れる。
			ci_json=$(jq -c '{head_sha: .headRefOid, checks: [.statusCheckRollup[]
				| if .__typename == "CheckRun" then {name, status, conclusion}
				  else {name: .context, status: .state, conclusion: .state} end]}' <<<"$raw") \
				|| { ci_json=null; echo 'CI の応答を整形できません' >"$err_file"; add_error ci; }
		else
			add_error ci
		fi
	else
		echo "pr_url を読めません: $pr_url" >"$err_file"
		add_error pr
		add_error ci
	fi
fi

printf 'null' >"$runs_json_file"
if raw=$(squad_cli_read issue-runs "$task" 2>"$err_file"); then
	if ! jq -c '[.[] | {id, agent_id, status, created_at}]' <<<"$raw" >"$runs_json_file"; then
		printf 'null' >"$runs_json_file"
		echo '実行の応答を整形できません' >"$err_file"; add_error runs
	fi
else
	add_error runs
fi

# 区切りの途中の決め方は squad-run-cut state の 1 か所にあるので、その出力の行を配列にする。
cuts_json=null
if raw=$("$here/squad-run-cut" state "$task" 2>"$err_file"); then
	cuts_json=$(jq -Rc --slurp '[split("\n")[] | select(startswith("区切り: ")) | ltrimstr("区切り: ") | split(" ")
		| {agent_id: .[0], state: .[1], comment_id: .[2]}]' <<<"$raw") \
		|| { cuts_json=null; echo '区切りの出力を整形できません' >"$err_file"; add_error cuts; }
else
	add_error cuts
fi

jq -nc --argjson task "$task_json" --slurpfile comments "$comments_json_file" --argjson pr "$pr_json" --argjson ci "$ci_json" \
	--slurpfile runs "$runs_json_file" --argjson cuts "$cuts_json" --argjson errors "$errors" '{
	schema_version: 1, task: $task, comments: $comments[0], pr: $pr, ci: $ci, runs: $runs[0], cuts: $cuts, errors: $errors}'
