#!/usr/bin/env bash
# multica-squad-kit-managed
# PR を作った直後に呼ぶ。紐付けに失敗しても、役は止まらずに引き継ぐ。
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/squad-pr-link-lib"
source "$(dirname "${BASH_SOURCE[0]}")/squad-cli-lib"

if [[ $# != 2 || -z $1 || ! $2 =~ ^https://github\.com/[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+/pull/[0-9]+$ ]]; then
	echo '使い方: squad-pr-link <タスク> <PR の URL (https://github.com/OWNER/REPO/pull/番号)>' >&2
	exit 2
fi
task=$1 url=$2 identifier=$1
warn() {
	printf 'タスク %s に PR %s を紐付けられませんでした（%s）。タスクの画面の PR の欄で、この URL を指定して紐付けてください。\n' "$identifier" "$url" "$1" >&2
}
# 404 で待ち切れたときだけ、連携と同期の確認を案内する。
warn_not_found() {
	local repository=${url#https://github.com/}
	repository=${repository%/pull/*}
	printf 'サーバーは、%s がワークスペースの GitHub 連携につながり、PR が同期されるまで、PR を見つけられません。ワークスペースの設定のコードの画面で、%s がつながっていることを確認してから紐付けてください。つながっていないと、タスクの画面からも紐付けられません。\n' "$repository" "$repository" >&2
}

mkdir -p tmp
diagnostic=$(mktemp tmp/pr-link-read.XXXXXX)
trap "$(printf 'rm -f -- %q' "$diagnostic")" EXIT
if ! issue=$(squad_cli_read issue-get "$task" 2>"$diagnostic"); then
	# CLI 自体の診断には認証情報が含まれ得る。約束の欄の診断だけを返す。
	sed -n '/^CLI の出力/p' "$diagnostic" >&2
	warn 'タスクを読めない'
	exit 1
fi
rm -f "$diagnostic"
trap - EXIT
if ! jq -e '(.id | type == "string" and length > 0)
	and (.identifier | type == "string" and length > 0)
	and (.metadata | type == "object")' <<<"$issue" >/dev/null; then
	warn 'タスクを読めない'
	exit 1
fi
id=$(jq -r '.id' <<<"$issue")
identifier=$(jq -r '.identifier' <<<"$issue")
metadata=$(jq -c '.metadata' <<<"$issue")
project=$(jq -r '.project_id | select(type == "string")' <<<"$issue")
repository=$(jq -r '.repository | select(. != null)' <<<"$metadata" | tr '[:upper:]' '[:lower:]')
url_repository=${url#https://github.com/}
url_repository=$(printf '%s' "${url_repository%/pull/*}" | tr '[:upper:]' '[:lower:]')
same_repository=0
if [[ $repository == "$url_repository" ]]; then same_repository=1; fi

fail_link() {
	warn "$1"
	if [[ ${PR_LINK_NOT_FOUND:-0} == 1 ]]; then warn_not_found; fi
	exit 1
}

finish_linked() {
	local label=$1 written=$2
	if ((same_repository)); then pr_link_record_remove "$project" "$url"; fi
	if ((written)); then
		printf '%s: %s %s\n' "$label" "$identifier" "$url"
		exit 0
	fi
	printf '%s（pr_url を書けない）: %s %s\n' "$label" "$identifier" "$url"
	exit 3
}

if [[ -n $repository ]] && ((! same_repository)); then
	fail_link 'metadata の repository と違う'
fi
if jq -e 'has("pr_url")' <<<"$metadata" >/dev/null; then
	existing_url=$(jq -r '.pr_url' <<<"$metadata")
	if [[ $existing_url != "$url" ]]; then
		printf 'タスク %s の metadata の pr_url は PR %s と違うため、紐付けは変えません。\n' "$identifier" "$url" >&2
	fi
	printf '紐付けていません: %s %s（metadata に pr_url があるため、API を呼びませんでした。紐付いているかは multica issue pull-requests で確認してください）\n' "$identifier" "$url"
	exit 0
fi

record=2
if ((same_repository)) && [[ -n $project ]]; then
	record=0
	pr_link_record_check "$project" "$url" || record=$?
fi
if ((record == 0)); then
	if pr_link_attempt_once "$id" "$url"; then finish_linked '紐付けました' 1; fi
else
	if pr_link_pull_request "$id" "$url" "$metadata"; then finish_linked '紐付けました' 1; fi
fi
if ((PR_LINK_LINKED && same_repository)) && [[ -n $project ]]; then finish_linked '紐付けました' 0; fi

listed=0
if ((same_repository)) && [[ -n $project ]]; then
	pr_link_listed "$id" "$url" || listed=$?
else
	listed=2
fi
if ((listed == 0)); then
	if pr_link_write_url "$id" "$url"; then finish_linked '紐付いていました' 1; fi
	finish_linked '紐付いていました' 0
fi

failure=$PR_LINK_REASON
if ((listed == 1)) && { ((record == 0)) || ((record == 1 && PR_LINK_ALL_404)); }; then
	multica issue metadata set "$id" --key pr_link_pending --value "$url" --type string >/dev/null 2>&1 || fail_link "$failure"
	pr_link_write_url "$id" "$url" || fail_link "$failure"
	kind='記録があった'
	if ((record == 1)); then
		created=0
		pr_link_record_create "$project" "$url" "$identifier" || created=$?
		case $created in
		0) kind='記録した' ;;
		2) ;;
		*) fail_link "$failure" ;;
		esac
	fi
	if ! multica issue metadata set "$id" --key pr_link_no_integration --value "$kind $url" --type string >/dev/null 2>&1; then
		pr_link_record_matches "$project" "$url" || fail_link "$failure"
	fi
	if [[ $kind == '記録した' ]]; then
		printf '連携なしにしました: %s %s\n' "$identifier" "$url"
	else
		printf '紐付けていません（連携なし）: %s %s\n' "$identifier" "$url"
	fi
	exit 0
fi

# あとの区切りで試み直せるよう、作業先が PR のリポジトリと同じと分かるときだけマークを残す。
if ((same_repository)); then
	multica issue metadata set "$id" --key pr_link_pending --value "$url" --type string >/dev/null 2>&1 || :
fi
fail_link "$failure"
