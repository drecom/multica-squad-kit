#!/usr/bin/env bash
# multica-squad-kit-managed
# Multica のエージェントが使う Claude と Codex の使用上限を見て、状態が変わったら Multica のタスクで知らせる。
# Multica は残りの使用量を見ず、使用上限で失敗したタスクも再試行しないため、止まる前と戻ったときに人が気づけるようにする。
# 使用上限で失敗したことは、Multica が task_failed の通知を受信箱に送るので、ここでは扱わない。
# Multica のオートパイロットから、各プロジェクト・メンバーの使用上限の見張り役が定期的に実行する。
# エージェントの実行の中で動かすのは、タスクをエージェントとして作り、担当者の受信箱に通知を届けるため
# （人のアカウントで作ると、自分の操作は自分に通知されない）。
# デーモンのホスト（macOS・Linux）で動く。
set -euo pipefail

# タスクの担当にする人（Multica のメンバーの名前）。担当者の受信箱に通知が届く。
: "${USAGE_CHECK_ASSIGNEE:?USAGE_CHECK_ASSIGNEE に、タスクの担当にするメンバーの名前を渡す}"
# 作るタスクを入れるプロジェクト。setup.sh が指示の置き換えで渡す。
: "${USAGE_CHECK_PROJECT:?USAGE_CHECK_PROJECT に、作るタスクを入れるプロジェクトの ID を渡す}"
# メンバーの区別はセットアップで選んだ値。同じ人の別のプロジェクトとも記録を分ける。
: "${USAGE_CHECK_MEMBER:?USAGE_CHECK_MEMBER に、メンバーの区別を渡す}"
# 保存先の要素として使うので、別のディレクトリを指す値は受け付けない。
for value in "$USAGE_CHECK_PROJECT" "$USAGE_CHECK_MEMBER"; do
	case "$value" in
	. | .. | *[!A-Za-z0-9_.-]*) echo 'プロジェクトとメンバーの区別には英数字・点・ハイフン・下線を使う' >&2; exit 1 ;;
	esac
done
usage_check_state_path() {
	printf '%s/%s/%s.state\n' "${USAGE_CHECK_STATE_ROOT:-$HOME/.multica-agent/template/usage-check}" "$USAGE_CHECK_PROJECT" "$USAGE_CHECK_MEMBER"
}
STATE_FILE=$(usage_check_state_path)
# 警告を出す使用率（%）。警告から使用上限までが短すぎて手当てが間に合わないなら下げ、タスクが多すぎるなら上げる。
USAGE_WARN_PERCENT=${USAGE_WARN_PERCENT:-80}
# ログインの期限が近いとして警告する、期限までの日数。Claude Code は期限の 3 日前から再ログインを促す。
# その前に、週に 1 回だけ見る人も間に合うよう、7 日を足した。
USAGE_LOGIN_WARN_DAYS=${USAGE_LOGIN_WARN_DAYS:-10}
if [[ ! $USAGE_LOGIN_WARN_DAYS =~ ^[0-9]{1,4}$ ]]; then
	echo 'USAGE_LOGIN_WARN_DAYS には、日数を 0 から 9999 の整数で渡す' >&2
	exit 1
fi
# StopFailure、CLAUDE_CODE_MAX_TURNS、auth status --json の期限を確認した最も古い Claude Code。lib/check.sh と同じ値にする。
claude_min_version=2.1.322
# 作るタスクに付けるラベル。開発のタスクと分け、開発の進み具合に数えないため（セットアップで作るラベル）。
LABEL_NAME=運用

# 見るランタイムはセットアップの選択を受け取る。古いバージョンの指示は両方を見る。
case ${USAGE_CHECK_RUNTIMES-claude codex} in
'claude codex') usage_check_runtimes=(claude codex) ;;
claude) usage_check_runtimes=(claude) ;;
codex) usage_check_runtimes=(codex) ;;
*) echo 'USAGE_CHECK_RUNTIMES は claude codex、claude、codex のいずれかを指定する' >&2; exit 1 ;;
esac

for cmd in jq python3 multica "${usage_check_runtimes[@]}"; do
	if ! command -v "$cmd" >/dev/null 2>&1; then
		echo "${cmd} が見つからない。デーモンのホストに入れる。" >&2
		exit 1
	fi
done

source "$(dirname "${BASH_SOURCE[0]}")/squad-usage-lib"

# 使用率から状態を決める。
level_of() {
	local percent=$1
	if ((percent >= 100)); then
		echo limited
	elif ((percent >= USAGE_WARN_PERCENT)); then
		echo warn
	else
		echo ok
	fi
}

# fetch_<ツール> は、枠ごとに「キー<TAB>状態<TAB>枠の名前<TAB>使用率とリセットの時刻」の行を出す。
# 取得に失敗したら、理由を stderr に出して 1 で終わる。

# Claude: /usage の表示を読む。モデルを呼ばないので、使用量を消費しない。
# 表示は「Current session: 25% used · resets Oct 19 at 1am (Asia/Tokyo)」のような行。
fetch_claude() {
	local rows
	rows=$(read_claude_usage) || return 1
	local name percent reset
	while IFS=$'\t' read -r name percent reset; do
		printf 'claude:%s\t%s\tClaude の %s\t%s%%（%s にリセット）\n' \
			"$name" "$(level_of "$percent")" "$name" "$percent" "$reset"
	done <<<"$rows"
}

# Codex: 共通の読み取りから、見張りの表示に変える。
fetch_codex() {
	local res
	res=$(read_codex_usage) || return 1

	# 枠の長さはプランで違う（primary が週のこともある）ので、windowDurationMins から名前を付ける。
	local limit_id window_mins percent resets_at window_name
	while IFS=$'\t' read -r limit_id window_mins percent resets_at; do
		case "$window_mins" in
		300) window_name="5 時間" ;;
		10080) window_name="週" ;;
		*) window_name="${window_mins} 分" ;;
		esac
		printf 'codex:%s:%s\t%s\tCodex の %s の%sの枠\t%s%%（%s にリセット）\n' \
			"$limit_id" "$window_mins" "$(level_of "$percent")" "$limit_id" "$window_name" "$percent" \
			"$(usage_epoch_format "$resets_at" '%m/%d %H:%M')"
	done < <(jq -r '
		.rateLimitsByLimitId | to_entries[] | .key as $id
		| (.value.primary, .value.secondary) | select(. != null)
		| [$id, .windowDurationMins, (.usedPercent | floor), .resetsAt] | @tsv' <<<"$res")

	# 枠の使用率が 100% 未満でも、クレジット切れなどで止まることがあるので、使えるかどうかも見る。
	if jq -e '.ordinaryUsageAllowed == false' <<<"$res" >/dev/null; then
		printf 'codex:allowed\tlimited\tCodex を使えるか\t使えない（%s）\n' \
			"$(jq -r '.rateLimits.rateLimitReachedType // "理由は不明"' <<<"$res")"
	else
		printf 'codex:allowed\tok\tCodex を使えるか\t使える\n'
	fi
}

# Claude Code のログインを読み、「状態<TAB>本文に書く説明」の 1 行を出す。状態は ok・warn・error・unverified。
# claude auth status --json の出力はメールアドレスと組織を含むので、loggedIn と loginExpiresAt だけを読み、出力は写さない。
# 説明に書くのは、バージョンの数、終了コード、期限の日付と残りの日数だけにする。
# macOS に timeout がなく、時間切れを分けて見るため、python3 で時間を区切って呼ぶ。
read_claude_login() {
	python3 - "$USAGE_LOGIN_WARN_DAYS" "$claude_min_version" <<'PY'
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone

warn_days, minimum = int(sys.argv[1]), sys.argv[2]
# 時間切れの秒数。既定の 30 秒を変えるのは、テストだけ。
limit = int(os.environ.get("USAGE_LOGIN_READ_SECONDS", "30"))


def finish(level, detail):
    print(f"{level}\t{detail}")
    sys.exit(0)


def run(*args):
    try:
        return subprocess.run(["claude", *args], stdin=subprocess.DEVNULL, capture_output=True,
                              text=True, errors="replace", timeout=limit)
    except subprocess.TimeoutExpired:
        finish("unverified", f"claude {' '.join(args)} が時間切れになった")
    except OSError:
        finish("unverified", f"claude {' '.join(args)} を実行できなかった")


# 古いバージョンでは、期限の欄がなくても、期限がないと読めてしまう。先にバージョンを見る。
versioned = run("--version")
if versioned.returncode != 0:
    finish("unverified", f"claude --version が終了コード {versioned.returncode} で終わった")
first = (versioned.stdout.split("\n") or [""])[0]
found = re.match(r"^(\d{1,6})\.(\d{1,6})\.(\d{1,6})(?:[^0-9.]|$)", first)
if not found:
    finish("unverified", "claude --version からバージョンを読めない")
version = tuple(int(part) for part in found.groups())
if version < tuple(int(part) for part in minimum.split(".")):
    finish("unverified", f"Claude Code {'.'.join(map(str, version))} は、最低のバージョン {minimum} より古い")

result = run("auth", "status", "--json")
code = result.returncode
try:
    status = json.loads(result.stdout)
    if not isinstance(status, dict):
        raise ValueError
except ValueError:
    status = None
logged_in = status.get("loggedIn") if status else None
if code == 1 and logged_in is False:
    finish("error", "ログインしていない（終了コード 1）")
if code != 0:
    finish("unverified", f"claude auth status --json が終了コード {code} で終わった")
if status is None:
    finish("unverified", "claude auth status --json の出力を JSON として読めない（終了コード 0）")
if logged_in is not True:
    finish("unverified", "claude auth status --json の loggedIn が true でない（終了コード 0）")

expires = status.get("loginExpiresAt")
if expires is None:
    finish("ok", "ログインしている（期限なし）")
try:
    if isinstance(expires, bool):
        raise ValueError
    if isinstance(expires, (int, float)):
        # ミリ秒の値は、秒にそろえる。
        epoch = expires / 1000 if expires > 1e11 else expires
    else:
        epoch = datetime.fromisoformat(str(expires).replace("Z", "+00:00")).timestamp()
    remaining = epoch - time.time()
    day = datetime.fromtimestamp(epoch, timezone.utc).astimezone().strftime("%Y-%m-%d")
except (ValueError, OverflowError, OSError):
    finish("unverified", "claude auth status --json の期限を日時として読めない（終了コード 0）")
if remaining <= 0:
    finish("error", f"ログインの期限を過ぎた（期限 {day}）")
days = int(remaining // 86400)
level = "warn" if remaining <= warn_days * 86400 else "ok"
finish(level, f"ログインの期限は {day}、残り {days} 日")
PY
}

# Codex は期限を返さない。出力は状態の判定だけに使い、説明には写さない。
read_codex_login() {
	python3 - <<'PY'
import os
import subprocess

limit = int(os.environ.get("USAGE_LOGIN_READ_SECONDS", "30"))
try:
    result = subprocess.run(["codex", "login", "status"], stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, errors="replace", timeout=limit)
except subprocess.TimeoutExpired:
    print("unverified\tcodex login status が時間切れになった")
except OSError:
    print("unverified\tcodex login status を実行できなかった")
else:
    code = result.returncode
    if code == 0:
        print("ok\tログインしている（終了コード 0）")
    elif code == 1 and result.stdout.strip() == "Not logged in":
        print("error\tログインしていない（終了コード 1）")
    else:
        print(f"unverified\tcodex login status が終了コード {code} で終わった")
PY
}

# 状態はキーごとの最新の観測と、起票済みタスクへの操作の記録。
state='{}'
if [[ -f "$STATE_FILE" ]]; then
	state=$(jq -ces 'select(length == 1) | .[0] | select(type == "object")' "$STATE_FILE") || exit 1
fi

# タスクを作るたびに保存する。途中で失敗しても、作ったタスクを忘れて同じものを作り直さないため。
save_state() {
	local next_state=$1 temp
	mkdir -p "$(dirname "$STATE_FILE")" || return 1
	temp=$(mktemp "${STATE_FILE}.XXXXXX") || return 1
	if ! printf '%s\n' "$next_state" >"$temp" || ! mv -f -- "$temp" "$STATE_FILE"; then
		rm -f -- "$temp"
		return 1
	fi
	state=$next_state
}

save_row() {
	local key=$1 row=$2 next_state
	next_state=$(jq -c --arg key "$key" --argjson row "$row" '.[$key] = $row' <<<"$state") || return 1
	save_state "$next_state"
}

# タスクにラベルを付ける。付けられなくてもタスクの状態の保存は続けるよう、失敗は返り値で返す。
add_label() {
	local id
	id=$(squad_cli_read label-list | jq -r --arg n "$LABEL_NAME" '[.[] | select(.name == $n)][0].id // empty') || true
	if [[ -z "$id" ]] || ! multica issue label add "$1" "$id" >/dev/null; then
		echo "タスク ${1} に、ラベル ${LABEL_NAME} を付けられなかった" >&2
		return 1
	fi
}

# 改行を保ち、コメントはファイルで CLI に渡す。
usage_comment() {
	local body code=0
	body=$(usage_tmpfile) || return 1
	cat >"$body" || { rm -f -- "$body"; return 1; }
	multica issue comment add "$1" --content-file "$body" --output table >/dev/null || code=$?
	rm -f -- "$body" || :
	return "$code"
}

# キーの種類ごとの、作るタスクの題の始め。ログインのキーは login: で始まる。
title_prefix() {
	case $1 in
	login:*) printf '[ログイン]' ;;
	*) printf '[使用上限]' ;;
	esac
}

# 状態ごとの始めの文。タスクを作るときの本文と、ok でない状態どうしの変化のコメントが使う。
state_sentence() {
	local key=$1 level=$2
	case "$key:$level" in
	login:*:warn) echo '期限が近い。期限の前に、manual.md の手順でログインし直す' ;;
	login:*:error) echo 'ログインしていない。このツールの役はすべて失敗する' ;;
	login:*:unverified) echo 'ログインを確認できない。バージョンとログインを確認する' ;;
	*:warn) echo '使用上限が近い。重い作業の割り振りを控えるか、エージェントを別の系統のモデルに寄せる' ;;
	*:limited) echo '使用上限に達した。リセットまで、このモデルのエージェントは失敗する' ;;
	*:error) echo '使用量を取れなくなり、見張れていない。ログインや表示の形が変わっていないか確認する' ;;
	esac
}

# タスクの本文のファイルを作り、パスを出す。作るときと、題と本文を書き換えるときが使う。
# 4 つ目に照合の行を渡すと、本文の最後の行に置く（起票の照合に使う。書き換えでは渡さない）。
write_description() {
	local key=$1 level=$2 detail=$3 mark_line=${4-} description
	description=$(usage_tmpfile) || return 1
	printf '%s\n\n%s\n\nこのタスクは使用上限の見張り（squad-usage-check）が作った。戻ったら、見張りがコメントして done にする。\n' \
		"$(state_sentence "$key" "$level")" "$detail" >"$description" || { rm -f -- "$description"; return 1; }
	if [[ -n $mark_line ]]; then
		printf '\n%s\n' "$mark_line" >>"$description" || { rm -f -- "$description"; return 1; }
	fi
	printf '%s\n' "$description"
}

# サーバーの読み取りを、時間切れ付きで実行する。標準出力に JSON を出し、失敗か時間切れなら 1 で終わる。
# CLI が止まると、ログインの警告を含む見張り全体が止まるので、時間を区切る。
read_server() {
	python3 - "$@" <<'PY'
import os
import subprocess
import sys

try:
    limit = int(os.environ.get("USAGE_TASK_READ_SECONDS", "30"))
    result = subprocess.run(
        ["multica", *sys.argv[1:]],
        stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=limit,
    )
except (OSError, ValueError, subprocess.TimeoutExpired):
    sys.exit(1)
sys.exit(result.returncode)
PY
}

read_task() {
	read_server issue get "$1" --output json
}

# 読み取りの結果は、この実行で確認したキーと ID の組にだけ使う。
task_failed=false
verified_pairs='{}'

issue_id_pattern() {
	printf '%s\n' '^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$'
}

remember_verification() {
	verified_pairs=$(jq --arg key "$1" --arg issue "$2" --argjson result "$3" '
		.[$key][$issue] = $result' <<<"$verified_pairs")
}

discard_row() {
	local key_json=$1 next_state
	next_state=$(jq --argjson key "$key_json" 'del(.[$key])' <<<"$state") || return 1
	# 保存に失敗しても、この実行では外した行の ID を使わない。
	state=$next_state
	save_state "$next_state"
}

# 0 は照合済み、1 は不一致、2 は読み取り失敗。失敗した組も同じ実行では読み直さない。
verify_task() {
	local key=$1 issue=$2 cached task prefix result
	cached=$(jq -r --arg key "$key" --arg issue "$issue" '.[$key][$issue] // empty' <<<"$verified_pairs") || return 2
	if [[ -n "$cached" ]]; then
		return "$cached"
	fi
	if ! task=$(read_task "$issue") || ! jq -es 'length == 1 and (.[0] | type == "object")' <<<"$task" >/dev/null 2>&1; then
		echo "タスク ${issue} をサーバーから読めなかった" >&2
		result=2
	else
		prefix=$(title_prefix "$key")
		if jq -e --arg project "$USAGE_CHECK_PROJECT" --arg agent "${MULTICA_AGENT_ID-}" --arg prefix "$prefix" \
			--arg key "$key" --arg issue "$issue" '
			.id == $issue and .project_id == $project and .creator_type == "agent"
			and ($agent | length) > 0 and .creator_id == $agent
			and (.title | type) == "string"
			and (.title | startswith($prefix + " ")) and (.title | endswith("（" + $key + "）"))' <<<"$task" >/dev/null; then
			result=0
		else
			result=1
			echo "状態のファイルのタスク ${issue} は、このキー（${key}）の見張りが作ったものと合わない。更新せず、状態から外した" >&2
			discard_row "$(jq -nc --arg key "$key" '$key')" || result=2
		fi
	fi
	if [[ $result != 0 ]]; then task_failed=true; fi
	remember_verification "$key" "$issue" "$result" || { task_failed=true; return 2; }
	return "$result"
}

# 区切りでキーと ID を連結せず、検証が終わるまで行を JSON のまま扱う。
# 状態のファイル全体を 1 回の jq で読み、形の合わない行と、前のバージョンの形でタスクのある行だけを出す。
# 処理済みの行が増えても、起動の検査で起こすプロセスの数を変えないため。
checked_state_rows() {
	jq -c --arg uuid "$(issue_id_pattern)" '
		def level: IN("ok", "warn", "limited", "error", "unverified");
		def issue: type == "string" and length == 36 and test($uuid);
		def boolean: type == "boolean";
		def optional($key; f): if has($key) then .[$key] | f else true end;
		def mark: type == "object" and (.op == "create" or .op == "comment") and (.to | level)
			and (.id | issue)
			and (if .op == "comment" then (.from | level) else (.to != "ok" and (has("from") | not)) end)
			and (keys - ["op", "from", "to", "id"] | length == 0);
		to_entries[] | .valid = (
			(.key | test("^(claude:|codex:|login:).+") and (explode | all(. >= 32 and (. < 127 or . > 159))))
			and (.value | type == "object" and (.level | level) and
				(if has("posted") then
					(.issue | issue) and (.posted | level) and (.labeled | boolean) and optional("shown"; level and . != "ok")
					and optional("pending"; mark and .op == "comment")
					and (keys - ["level", "issue", "posted", "shown", "labeled", "pending"] | length == 0)
				elif has("pending") then
					(.pending | mark and .op == "create") and (keys - ["level", "pending"] | length == 0)
				else
					optional("issue"; . == "" or issue) and optional("keyed"; boolean) and optional("retitle"; boolean)
					and (keys - ["level", "issue", "keyed", "retitle"] | length == 0)
				end)))
		| select((.valid | not) or (.value | (has("posted") or has("pending") or keys == ["level"]) | not))' <<<"$state"
}

migrate_task() {
	local key=$1 issue=$2 level=$3
	verify_task "$key" "$issue" || return 1
	save_row "$key" "$(jq -nc --arg level "$level" --arg issue "$issue" \
		'{level: $level, issue: $issue, posted: $level, labeled: false}')"
}

# 見張らないランタイムも含め、不正な行を外し、前の形の開いたタスクを照合する。
reconcile_legacy_tasks() {
	local entries entry key key_json issue level
	entries=$(checked_state_rows) || return 1
	while IFS= read -r entry; do
		[[ -n "$entry" ]] || continue
		if ! jq -e '.valid' <<<"$entry" >/dev/null; then
			key_json=$(jq -c '.key' <<<"$entry") || return 1
			echo "状態のファイルの行 ${key_json} の形が合わない。状態から外した" >&2
			task_failed=true
			discard_row "$key_json" || task_failed=true
			continue
		fi
		key=$(jq -r '.key' <<<"$entry") || return 1
		issue=$(jq -r '.value.issue // empty' <<<"$entry") || return 1
		level=$(jq -r '.value.level' <<<"$entry") || return 1
		if [[ -n "$issue" ]]; then
			migrate_task "$key" "$issue" "$level" || task_failed=true
		else
			save_row "$key" "$(jq -nc --arg level "$level" '{level: $level}')" || task_failed=true
		fi
	done <<<"$entries"
}

# ok でない状態どうしの変化で、同じタスクの題と本文を新しい状態のものに書き換える。
update_task_text() {
	local key=$1 issue=$2 level=$3 title=$4 detail=$5 description
	description=$(write_description "$key" "$level" "$detail") || return 1
	multica issue update "$issue" --title "$(title_prefix "$key") ${title}（${key}）" --description-file "$description" >/dev/null || {
		rm -f -- "$description"
		return 1
	}
	rm -f -- "$description" || :
}

# 変化のコメントの本文。使用率などの値を含む。
change_body() {
	local key=$1 level=$2 prev=$3 detail=$4
	case "$level:$prev:${key%%:*}" in
	ok:*:login) printf 'ログインし直された。\n\n%s\n' "$detail" ;;
	limited:*) printf '使用上限に達した。リセットまで、このモデルのエージェントは失敗する。\n\n%s\n' "$detail" ;;
	ok:error:*) printf '使用量をまた取れるようになった。\n' ;;
	*:limited:*) printf '戻った。使用上限で失敗したタスクは multica issue rerun で再実行する。\n\n%s\n' "$detail" ;;
	ok:warn:*) printf 'リセットされた。\n\n%s\n' "$detail" ;;
	*) printf '%s。\n\n%s\n' "$(state_sentence "$key" "$level")" "$detail" ;;
	esac
}

# 照合の行。値の入る本文と別に、キーと状態と印の ID だけで、送ったかを照合できるようにする。
# 起票は本文の最後の行、変化のコメントはコメントの最後の行に置く。
create_line() {
	printf '（%s: %s / %s）' "$1" "$2" "$3"
}

change_line() {
	printf '（%s: %s → %s / %s）' "$1" "$3" "$2" "$4"
}

# 状態の変化を、既存のタスクにコメントする。最後の行は change_line。
comment_change() {
	local key=$1 level=$2 prev=$3 issue=$4 detail=$5 mark_id=$6
	{
		change_body "$key" "$level" "$prev" "$detail"
		printf '\n%s\n' "$(change_line "$key" "$level" "$prev" "$mark_id")"
	} | usage_comment "$issue"
}

# 印の ID は、印を保存するときに見張りが作る乱数の UUID。
new_mark_id() {
	python3 -c 'import uuid; print(uuid.uuid4())'
}

# 送る前の印を付けた行を作る。操作は create か comment。5 つ目に印の ID を渡すと、新しく作らずそれを使う。
marked_row() {
	local row=$1 op=$2 to=$3 from=${4-} id=${5-}
	[[ -n $id ]] || id=$(new_mark_id) || return 1
	jq -c --arg op "$op" --arg to "$to" --arg from "$from" --arg id "$id" '
		.pending = ({op: $op, to: $to, id: $id} + (if $op == "comment" then {from: $from} else {} end))' <<<"$row"
}

# 起票の照合に使う、プロジェクトのタスクの一覧。1 回の実行で 1 度だけ全ページ読み、起票の印のあるすべての行で使う。
# 候補の絞り込みまでをここでして、JSON の配列のまま created_tasks に持つ。読めなければ、同じ実行では読み直さずに失敗を返す。
created_tasks=
created_tasks_status=
load_created_tasks() {
	case $created_tasks_status in
	ok) return 0 ;;
	failed)
		echo 'プロジェクトのタスクの一覧を読めなかったので、起票を照合できない' >&2
		return 1
		;;
	esac
	local pages offset=0 page meta more count
	created_tasks_status=failed
	pages=$(usage_tmpfile) || return 1
	while :; do
		if ! page=$(read_server issue list --project "$USAGE_CHECK_PROJECT" --limit 100 --offset "$offset" \
			--sort created_at --direction asc --output json); then
			echo "プロジェクトのタスクの一覧を読めなかった" >&2
			rm -f -- "$pages"
			return 1
		fi
		meta=$(jq -r 'select(type == "object" and (.issues | type) == "array" and (.has_more | type) == "boolean")
			| [.has_more, (.issues | length)] | @tsv' <<<"$page" 2>/dev/null) || meta=
		if [[ -z $meta ]]; then
			echo "プロジェクトのタスクの一覧の形が合わない" >&2
			rm -f -- "$pages"
			return 1
		fi
		IFS=$'\t' read -r more count <<<"$meta"
		jq -c . <<<"$page" >>"$pages" || { rm -f -- "$pages"; return 1; }
		[[ $more == true ]] || break
		if ((count == 0)); then
			echo 'プロジェクトのタスクの一覧が、続きがあるのに空だった' >&2
			rm -f -- "$pages"
			return 1
		fi
		offset=$((offset + count))
	done
	# 全ページを 1 つの配列にし、作者・プロジェクト・状態で絞る。本文は大きいので、題と本文の最後の行の照合まで残す。
	if ! created_tasks=$(jq -cs --arg project "$USAGE_CHECK_PROJECT" --arg agent "${MULTICA_AGENT_ID-}" '
		[.[].issues[] | select(type == "object" and ($agent | length) > 0 and .project_id == $project
			and .creator_type == "agent" and .creator_id == $agent
			and (.status | IN("done", "cancelled") | not)
			and (.title | type) == "string")]' "$pages"); then
		echo "プロジェクトのタスクの一覧の形が合わない" >&2
		rm -f -- "$pages"
		return 1
	fi
	rm -f -- "$pages"
	created_tasks_status=ok
}

# 起票の照合。印のキー・状態・印の ID の照合の行が本文の最後の行にあるタスクを、新しい順に探す。
# {"ids": [UUID の形の ID...], "invalid": UUID の形でない ID の候補の数} を JSON で出す。load_created_tasks のあとに呼ぶ。
match_created_tasks() {
	local key=$1 line=$2
	jq -c --arg prefix "$(title_prefix "$key")" --arg key "$key" --arg line "$line" --arg uuid "$(issue_id_pattern)" '
		def last_line: (.description | if type == "string" then split("\n") else [] end
			| map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0)) | last // "");
		def seconds: (.created_at | if type == "string" then (try (sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601) catch 0) else 0 end);
		def fraction: (.created_at | if type == "string" then ((capture("\\.(?<f>[0-9]+)") // {f: "0"}) | .f | ("0." + .) | tonumber) else 0 end);
		[.[] | select((.title | startswith($prefix + " ")) and (.title | endswith("（" + $key + "）")) and last_line == $line)]
		| sort_by([seconds, fraction]) | reverse
		| {ids: [.[].id | select(type == "string" and length == 36 and test($uuid))],
			invalid: ([.[].id | select((type == "string" and length == 36 and test($uuid)) | not)] | length)}' <<<"$created_tasks"
}

# コメントの照合。見張りの作者の最新のコメントの最後の行が、期待する行と同じなら 0、違えば 1、読めなければ 2 で終わる。
comment_was_posted() {
	local issue=$1 expected=$2 comments code=0
	if ! comments=$(read_server issue comment list "$issue" --full --output json); then
		echo "タスク ${issue} のコメントを読めなかった" >&2
		return 2
	fi
	python3 -c '
import json
import re
import sys
from datetime import datetime, timezone

agent, expected = sys.argv[1:3]


def epoch(value):
    text = re.sub(r"\.(\d+)", lambda m: "." + m.group(1)[:6].ljust(6, "0"), str(value)).replace("Z", "+00:00")
    parsed = datetime.fromisoformat(text)
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.timestamp()


try:
    comments = json.load(sys.stdin)
    if not isinstance(comments, list):
        sys.exit(2)
    mine = []
    for number, comment in enumerate(comments):
        if (isinstance(comment, dict) and agent and comment.get("author_type") == "agent"
                and comment.get("author_id") == agent and isinstance(comment.get("content"), str)):
            mine.append((epoch(comment["created_at"]), number, comment["content"]))
except (ValueError, KeyError, TypeError, AttributeError):
    sys.exit(2)
if not mine:
    sys.exit(1)
lines = [line.strip() for line in max(mine)[2].splitlines() if line.strip()]
sys.exit(0 if lines and lines[-1] == expected else 1)
' "${MULTICA_AGENT_ID-}" "$expected" <<<"$comments" || code=$?
	if ((code == 2)); then echo "タスク ${issue} のコメントの形が合わない" >&2; fi
	return "$code"
}

# 印のある行を、送る前にサーバーで照合する。
# 0 は照合できた。済んでいれば済んだ欄を書き、済んでいなければ印だけを消して、どちらも保存した。
# 済んでいなかったときは、送り直す印の ID を resend_op と resend_id に残す。
# 1 は照合できなかった。印は残し、送らない。確認で合わず行を外したときも 1 を返し、行は状態にない。
# 2 は候補の ID が UUID の形でなかった。印を残し、状態にもタスクにも何も書かない。
resend_op=
resend_id=
reconcile_pending() {
	local key=$1 row=$2 op to id from issue result newest others count
	resend_op=
	resend_id=
	IFS=$'\t' read -r op to id from issue < <(jq -r '[.pending.op, .pending.to, .pending.id,
		(.pending.from // ""), (.issue // "")] | @tsv' <<<"$row") || return 1
	case $op in
	create)
		load_created_tasks || return 1
		result=$(match_created_tasks "$key" "$(create_line "$key" "$to" "$id")") || return 1
		if [[ $(jq -r '.invalid' <<<"$result") != 0 ]]; then
			echo "一覧の候補の ID が UUID の形でないので、何も書かず、印を残した（${key}）" >&2
			return 2
		fi
		count=$(jq -r '.ids | length' <<<"$result") || return 1
		if ((count > 0)); then
			newest=$(jq -r '.ids[0]' <<<"$result") || return 1
			if ((count > 1)); then
				others=$(jq -r '.ids[1:] | join(" ")' <<<"$result") || return 1
				echo "同じ印の ID の起票が重なった（${key}）。新しい ${newest} を使う。閉じてよいタスク: ${others}" >&2
			fi
			row=$(jq -c --arg issue "$newest" --arg to "$to" '
				{level: .level, issue: $issue, shown: $to, posted: $to, labeled: false}' <<<"$row") || return 1
			echo "送ったかを照合し、起票済みのタスク ${newest} を引き継いだ（${key}）" >&2
			save_row "$key" "$row" || return 1
			remember_verification "$key" "$newest" 0 || return 1
			return 0
		fi
		;;
	comment)
		verify_task "$key" "$issue" || return 1
		local code=0
		comment_was_posted "$issue" "$(change_line "$key" "$to" "$from" "$id")" || code=$?
		((code <= 1)) || return 1
		if ((code == 0)); then
			echo "送ったかを照合し、コメント済みのタスク ${issue} を引き継いだ（${key}）" >&2
			row=$(jq -c --arg to "$to" '.posted = $to | del(.pending)' <<<"$row") || return 1
			save_row "$key" "$row" || return 1
			return 0
		fi
		;;
	esac
	row=$(jq -c 'del(.pending)' <<<"$row") || return 1
	save_row "$key" "$row" || return 1
	resend_op=$op
	resend_id=$id
}

# 既に通知した状態と最新の観測から、今回必要な操作を決める。
# 各操作が済んだ時点でその欄を保存し、失敗した操作は次の実行でやり直す。
# 起票と変化のコメントは、送る前に印を保存する。印を保存できなければ送らない。
apply() {
	local key=$1 level=$2 title=$3 detail=$4
	local row issue prev posted shown labeled response description uuid pending marked mark_id
	resend_op=
	resend_id=
	row=$(jq -c --arg key "$key" '.[$key] // {}' <<<"$state") || return 1
	prev=$(jq -r '.level // empty' <<<"$row") || return 1
	issue=$(jq -r '.issue // empty' <<<"$row") || return 1
	posted=$(jq -r '.posted // empty' <<<"$row") || return 1

	if [[ -n "$issue" && -z "$posted" ]]; then
		# 読めなかった旧形式の行は、観測も前回のまま次の実行へ渡す。
		migrate_task "$key" "$issue" "$prev" || { task_failed=true; return 0; }
		row=$(jq -c --arg key "$key" '.[$key]' <<<"$state") || return 1
		posted=$prev
	fi
	pending=$(jq -c '.pending // empty' <<<"$row") || return 1
	if [[ -n "$pending" ]]; then
		# 送ったかが分からない操作を、重ねて送る前に、サーバーで照合する。
		local reconciled=0
		reconcile_pending "$key" "$row" || reconciled=$?
		if ((reconciled != 0)); then
			# 照合できなくても、最新の観測は印を残したまま保存する。確認で合わず外した行は、書き戻さない。
			# 候補の ID が UUID の形でないときは、観測も含めて何も書かない。
			if ((reconciled == 1)) && [[ "$level" != "$prev" ]]; then
				row=$(jq -c --arg key "$key" '.[$key] // empty' <<<"$state") || row=
				if [[ -n $row ]]; then
					row=$(jq -c --arg level "$level" '.level = $level' <<<"$row") && save_row "$key" "$row" || true
				fi
			fi
			return 1
		fi
		row=$(jq -c --arg key "$key" '.[$key] // {}' <<<"$state") || return 1
		prev=$(jq -r '.level // empty' <<<"$row") || return 1
		issue=$(jq -r '.issue // empty' <<<"$row") || return 1
		posted=$(jq -r '.posted // empty' <<<"$row") || return 1
	fi
	if [[ "$level" != "$prev" ]]; then
		# 観測されていない正常な使用枠のためだけには行を増やさない。
		if [[ "$level" == ok && -z "$prev" && "$key" != login:* ]]; then return 0; fi
		row=$(jq -c --arg level "$level" '.level = $level' <<<"$row") || return 1
		save_row "$key" "$row" || return 1
	fi

	if [[ -z "$issue" ]]; then
		[[ "$level" != ok ]] || return 0
		# 照合で済んでいないと分かった印の ID は、送り直しでも同じものを使う。
		marked=$(marked_row "$row" create "$level" "" "$([[ $resend_op == create ]] && echo "$resend_id" || true)") || return 1
		if ! save_row "$key" "$marked"; then
			echo "起票の前の印を保存できなかった。起票しない（${key}）" >&2
			return 1
		fi
		mark_id=$(jq -r '.pending.id' <<<"$marked") || return 1
		description=$(write_description "$key" "$level" "$detail" "$(create_line "$key" "$level" "$mark_id")") || return 1
		if ! response=$(squad_cli_read issue-create "$(title_prefix "$key") ${title}（${key}）" "$description" \
			--assignee "$USAGE_CHECK_ASSIGNEE" --project "$USAGE_CHECK_PROJECT"); then
			rm -f -- "$description"
			return 1
		fi
		rm -f -- "$description"
		uuid=$(issue_id_pattern)
		if ! issue=$(jq -er --arg uuid "$uuid" '.id | select(type == "string" and length == 36 and test($uuid))' <<<"$response"); then
			echo '起票したタスクの ID を確認できなかった' >&2
			return 1
		fi
		row=$(jq -nc --arg level "$level" --arg issue "$issue" \
			'{level: $level, issue: $issue, shown: $level, posted: $level, labeled: false}') || return 1
		save_row "$key" "$row" || return 1
		remember_verification "$key" "$issue" 0 || return 1
		posted=$level
	fi

	shown=$(jq -r '.shown // empty' <<<"$row") || return 1
	labeled=$(jq -r '.labeled' <<<"$row") || return 1
	if [[ "$level" != ok && "$shown" == "$level" && "$posted" == "$level" && "$labeled" == true ]]; then
		return 0
	fi
	verify_task "$key" "$issue" || { task_failed=true; return 0; }

	if [[ "$level" != ok && "$labeled" != true ]]; then
		if add_label "$issue"; then
			row=$(jq -c '.labeled = true' <<<"$row") || return 1
			save_row "$key" "$row" || return 1
		else
			task_failed=true
		fi
	fi
	if [[ "$level" != ok && "$shown" != "$level" ]]; then
		if update_task_text "$key" "$issue" "$level" "$title" "$detail"; then
			row=$(jq -c --arg level "$level" '.shown = $level' <<<"$row") || return 1
			save_row "$key" "$row" || return 1
		else
			echo "タスク ${issue} の題と本文を書き換えられなかった" >&2
			task_failed=true
		fi
	fi
	if [[ "$posted" != "$level" ]]; then
		marked=$(marked_row "$row" comment "$level" "$posted" "$([[ $resend_op == comment ]] && echo "$resend_id" || true)") || return 1
		if ! save_row "$key" "$marked"; then
			echo "タスク ${issue} のコメントの前の印を保存できなかった。コメントしない" >&2
			task_failed=true
		else
			row=$marked
			mark_id=$(jq -r '.pending.id' <<<"$marked") || return 1
			if comment_change "$key" "$level" "$posted" "$issue" "$detail" "$mark_id"; then
				row=$(jq -c --arg level "$level" '.posted = $level | .level = $level | del(.pending)' <<<"$row") || return 1
				save_row "$key" "$row" || return 1
				posted=$level
			else
				echo "タスク ${issue} の変化をコメントできなかった" >&2
				task_failed=true
			fi
		fi
	fi
	if [[ "$level" == ok && "$posted" == ok ]]; then
		multica issue status "$issue" done --no-start >/dev/null || return 1
		save_row "$key" '{"level":"ok"}' || return 1
	fi
}

# 観測が確定しない実行で、最新の観測を要しない操作を、前回の level で続ける。
# 送った起票とコメントの印の照合と、それに続く引き継ぎとラベルだけを続ける。
# 題と本文とコメントは観測の値を書くので、次の確定した観測へ回す。ok への戻りも、観測が確定するまで保留する。
continue_row() {
	local key=$1 row issue labeled
	row=$(jq -c --arg key "$key" '.[$key] // {}' <<<"$state") || return 1
	if jq -e 'has("pending")' <<<"$row" >/dev/null; then
		reconcile_pending "$key" "$row" || return 1
		row=$(jq -c --arg key "$key" '.[$key] // {}' <<<"$state") || return 1
	fi
	issue=$(jq -r 'select(has("posted") and .level != "ok") | .issue // empty' <<<"$row") || return 1
	labeled=$(jq -r '.labeled // false' <<<"$row") || return 1
	[[ -n $issue && $labeled != true ]] || return 0
	verify_task "$key" "$issue" || return 1
	if add_label "$issue"; then
		row=$(jq -c '.labeled = true' <<<"$row") || return 1
		save_row "$key" "$row"
	else
		return 1
	fi
}

# ツールの使用上限の行のうち、印のある行と、ラベルが残る行だけについて、continue_row を行う。
# 1 回の jq で選ぶので、処理済みの行が増えても、起こすプロセスの数は変わらない。
continue_tool_rows() {
	local tool=$1 key
	while IFS= read -r key; do
		[[ -z $key ]] || continue_row "$key" || task_failed=true
	done < <(jq -r --arg p "${tool}:" 'to_entries[]
		| select((.key | startswith($p)) and .key != ($p + "fetch"))
		| select(.value | type == "object" and (has("pending")
			or (has("posted") and .level != "ok" and (.labeled // false) != true)))
		| .key' <<<"$state")
}

# 1 つのツールの結果を、枠ごとに反映する。
# 取得に失敗したツールは、枠の状態を前回のままにする（見えないあいだに戻ったことにしないため）。
usage_read_ok=false
check() {
	local tool=$1 label=$2 rows err_file
	usage_read_ok=false
	err_file=$(usage_tmpfile) || { task_failed=true; return; }
	if ! rows=$("fetch_${tool}" 2>"$err_file"); then
		apply "${tool}:fetch" error "${label} の使用量を取れない" "$(cat "$err_file")" || task_failed=true
		rm -f "$err_file"
		continue_tool_rows "$tool"
		return
	fi
	rm -f "$err_file"
	usage_read_ok=true
	apply "${tool}:fetch" ok "${label} の使用量を取れない" "" || task_failed=true

	# 前回あって今回ない枠は、リセットで表示から消えたものとして ok に戻す。
	local key
	while IFS= read -r key; do
		[[ -z "$key" ]] && continue
		if ! cut -f1 <<<"$rows" | grep -qxF "$key"; then
			rows+=$'\n'"${key}"$'\tok\t'"${label} の ${key#*:}"$'\t'"表示から消えた（リセットされた）"
		fi
	done < <(jq -r --arg p "${tool}:" 'keys[] | select(startswith($p) and . != ($p + "fetch"))' <<<"$state")

	local level title detail
	while IFS=$'\t' read -r key level title detail; do
		[[ -z "$key" ]] && continue
		apply "$key" "$level" "$title" "${title}: ${detail}" || task_failed=true
	done <<<"$rows"
}

# 見張るランタイムのログインの行を反映する。
# ログインの読み取りはローカルの状態だけを見るので、資格が無効でも ok になる。
# warn・error・確認失敗から ok に戻すのは、同じ実行で使用量を読めたときだけにする。読めなければ前回のままにし、ラベルなどの操作だけを続ける。
# ログインが error のときは、使用率を読まない（同じ原因で、使用量を取れないタスクが重ならないため）。
check_login() {
	local tool=$1 usage_label=$2 login_label=$3
	local key="login:${tool}" login level detail prev
	login=$("read_${tool}_login") || login=$'unverified\t'"${tool} のログインの読み取りが失敗した"
	level=${login%%$'\t'*}
	detail=${login#*$'\t'}
	if [[ $level == error ]]; then
		usage_read_ok=false
		continue_tool_rows "$tool"
	else
		check "$tool" "$usage_label"
	fi
	prev=$(jq -r --arg key "$key" '.[$key].level // "ok"' <<<"$state") || { task_failed=true; return; }
	if [[ $level == ok && $usage_read_ok != true ]]; then
		if [[ $prev != ok ]]; then
			echo "${login_label} のログインはローカルでは ok だが、使用量を読めないので、ログインの行は ${prev} のままにした" >&2
			continue_row "$key" || task_failed=true
		elif jq -e --arg key "$key" '.[$key] | type == "object" and has("pending")' <<<"$state" >/dev/null; then
			continue_row "$key" || task_failed=true
		fi
		return
	fi
	local title="${login_label} のログイン"
	case $level in
	warn) title+='の期限' ;;
	unverified) title+='を確認できない' ;;
	esac
	apply "$key" "$level" "$title" "$detail" || task_failed=true
}

reconcile_legacy_tasks || exit 1
for runtime in "${usage_check_runtimes[@]}"; do
	case $runtime in
	claude) check_login claude Claude 'Claude Code' ;;
	codex) check_login codex Codex Codex ;;
	esac
done
# ラベルを付けられなかったことと、タスクの作成・確認・更新に失敗したことを、実行の結果で人に知らせる。
if $task_failed; then
	exit 1
fi
