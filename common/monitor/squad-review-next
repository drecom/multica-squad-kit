	printf '%s\n%s\n' "$labels" "$label_list" | jq -rs \
		'.[0] as $labels | .[1] as $all | any($all[]; .name == "重要" and .resource_type == "issue" and (.id as $id | any($labels[]; .id == $id)))'
}

