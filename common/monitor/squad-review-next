import bisect
import re

FENCE = re.compile(r"(`{3,}|~{3,})")
SPECIAL = re.compile(r"\\|`+|<!--")
DROPPED = "（コードの囲みや HTML は PR の本文の注意を読む）"


def fence_closes(line, fence):
    """開いた囲みを閉じる行か。開きと同じ文字が、開きの長さ以上で並び、あとは空白だけ。"""
    return re.fullmatch(re.escape(fence[0]) + "{" + str(len(fence)) + ",}[ ]*", line) is not None


def comment_start(text, pos, index):
    """pos 以降で、コードスパンとバックスラッシュの外にある最初の `<!--` の位置。なければ -1。
    行の長さに比例する時間で終える。次に見る記号まで正規表現で飛び、閉じる逆引用符は、同じ長さの並びを行ごとに 1 回だけ集めた index から引く。
    index は同じ行の呼び出しで使い回す空のリストで、最初に逆引用符を見たときに中身を作る。"""
    while True:
        found = SPECIAL.search(text, pos)
        if not found:
            return -1
        mark = found.group(0)
        if mark == "\\":
            pos = found.start() + 2
        elif mark == "<!--":
            return found.start()
        else:
            if not index:
                runs = {}
                for run in re.finditer("`+", text):
                    runs.setdefault(len(run.group(0)), []).append(run.start())
                index.append(runs)
            after = found.end()
            starts = index[0].get(len(mark), [])
            at = bisect.bisect_left(starts, after)
            pos = starts[at] + len(mark) if at < len(starts) else after


def markup_step(text, state):
    """整えた 1 行を、状態 state から読む。(囲みやコメントに触れた行か, 次の状態) を返す。
    state は、囲みやコメントの外なら None、コメントの中なら "comment"、囲みの中なら開きの記号（``` や ~~~）。
    触れた行は、開く行・中の行・閉じる行・同じ行で開いて閉じる行で、見える文字が残っていても捨てる行にする。
    囲みの中ではコメントの記号を、コメントの中では囲みの記号を見ない。"""
    if state not in (None, "comment"):
        return True, (None if fence_closes(text, state) else state)
    if state is None:
        opened = FENCE.match(text)
        if opened:
            return True, opened.group(1)
    touched, pos, index = state == "comment", 0, []
    while True:
        if state == "comment":
            end = text.find("-->", pos)
            if end < 0:
                return True, "comment"
            pos, state = end + 3, None
        else:
            start = comment_start(text, pos, index)
            if start < 0:
                return touched, None
            touched, pos, state = True, start + 2, "comment"


MENTION_HEAD = re.compile(r"\]\(mention://", re.IGNORECASE)


def unlink_mentions(text):
    """メンションのリンク [名前](mention://…) を名前だけにし、残る mention:// は mention: // に直す。
    ]( の位置から前へ戻って開きを探すので、[ が長く続く行でも行の長さに比例する時間で終える。"""
    out, pos, end = [], 0, -1
    for head in MENTION_HEAD.finditer(text):
        if head.start() < pos:
            continue
        if end < head.end():
            end = text.find(")", head.end())
            if end < 0:
                break
        close = text.rfind("]", pos, head.start())
        opened = text.find("[", pos if close < 0 else close + 1, head.start())
        if opened < 0:
            continue
        out.append(text[pos:opened])
        out.append(text[opened + 1:head.start()])
        pos = end + 1
    out.append(text[pos:])
    return "".join(out).replace("mention://", "mention: //")

