import re
import sys

HEAD = "マージの前に人間がすること: "
MAX_LINES, MAX_CHARS = 10, 800
CONTROL = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f]")
BULLET = re.compile(r"(?:[-*+]|[0-9]{1,9}[.)])(?=\s|\Z)")


def section(body):
    """見出しの行から次の `##` の見出しの前まで。見出しがなければ None。
    コードの囲みと HTML コメントを本文の先頭から追い、どちらにも入っていない行の見出しだけを節の開始と終了に使う。"""
    found = None
    result = []
    state = None
    for line in body.splitlines():
        if state is None:
            if found is None:
                if re.fullmatch(r"##[ \t]+注意[ \t]*", line):
                    found = True
                    continue
            elif re.match(r"##(?:[ \t]|\Z)", line):
                break
        if found:
            result.append(line)
        _, state = markup_step(strip_marks(CONTROL.sub("", line.replace("\t", " "))), state)
    return result if found else None


def strip_marks(line):
    """行頭の空白、`>`、箇条書きの記号を、なくなるまで外す。長い行でも、行の長さに比例する時間で終える。"""
    pos = 0
    while pos < len(line):
        if line[pos].isspace():
            pos += 1
        elif line[pos] == ">":
            pos += 1
        else:
            found = BULLET.match(line, pos)
            if not found:
                break
            pos = found.end()
    return line[pos:].strip()


def heading_shaped(body):
    """注意の見出しの形の行の数。本文のすべての行を、囲み・コメント・HTML ブロックの中も含めて数える。
    各行を整える 1 と 2（制御文字を除き、タブを空白にし、行頭の記号を外す）で整え、`#` の並び、空白、`注意` の順で始まり、
    あとが空白と `#` だけの行を 1 つと数える。"""
    return sum(
        re.fullmatch(r"#+[ ]*注意[ #]*", strip_marks(CONTROL.sub("", line.replace("\t", " ")))) is not None
        for line in body.splitlines()
    )


def shape(raw_lines):
    """整えた行の並びと、捨てた行があったかを返す。"""
    kept, dropped, state = [], False, None
    for raw in raw_lines:
        line = strip_marks(CONTROL.sub("", raw.replace("\t", " ")))
        touched, state = markup_step(line, state)
        if touched:
            dropped = True
            continue
        if line == "":
            continue
        if line.startswith("<"):
            dropped = True
            continue
        kept.append(unlink_mentions(line))
    if dropped:
        kept.append(DROPPED)
    return kept


body = sys.stdin.read()
