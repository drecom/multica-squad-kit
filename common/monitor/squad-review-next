def final_pending(round_of):
    """最終レビューの回が済んでいなければ、その理由を返す。済んでいれば None。依頼があるだけでは済みにしない。"""
    ids = waited(round_of)
    if not ids:
        return "返事を待つ役の行がない"
    for role_id in ids:
        name = key_of.get(role_id, role_id)
        reply = latest_reply(round_of, role_id)
        if reply is None:
            return f"返事の結果がない: {name}"
        if is_unexecuted(reply):
            return f"検証スキルが未記入で未実行（{name}）"
        result = parse_result(reply, round_of.get("id"))
        if result is None:
            return f"返事の結果が読めない: {name}"
        if not matches(result, round_of):
            return f"確認したコミットが合わない: {name}"
        if result["design"]:
            return f"設計への指摘: あり（{name}）"
        if result["mark"] == "ng":
            return f"❌ の結果がある（{name}）"
    return None


CONTROL = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f]")
LEAD = re.compile(r"(?:[-*+]|[0-9]{1,9}\))(?=\s|\Z)")
PRE_COUNT = re.compile(r"前からある不具合 ([0-9]+) 件")
LIST_HEAD = re.compile(r"指摘の一覧:[ \t]*([0-9]+)[ \t]*件")
MAX_ITEMS, MAX_ITEM_CHARS = 10, 200


def tidy(text, mentions=True):
    """写す文を整える。docs/merge-request-reading.md の「写す文の整え方」の 1・2・5。指摘の行の `<番号>.` は残す。4 は行の並びを見る finding_list が行う。
    mentions を False にすると、5（メンションのリンクの置き換え）をしない。囲みとコメントを見分けるときは、置き換える前の文を読む。"""
    text = CONTROL.sub("", text.replace("\t", " "))
    pos = 0
    while pos < len(text):  # 末尾全体を写さず、位置で進める。行の長さに比例する時間で終える
        if text[pos].isspace() or text[pos] == ">":
            pos += 1
        else:
            found = LEAD.match(text, pos)
            if not found:
                break
            pos = found.end()
    text = text[pos:]
    if not mentions:
        return text.strip()
    return unlink_mentions(text.strip())


def safe_name(name):
    """マークの行の役の名前を、`- <役> ` の直後に置けるようにする。行頭が項目や囲みや HTML の記号に読まれないようにする。"""
    return re.sub(r"^[<>`~#*+-]+", "", tidy(name)) or "役"


def finding_list(reply):
    """返事のコメントの `指摘の一覧:` を (件数, 項目の並び, 捨てた項目の数) で返す。1 つでなく、件数が 1 以上の数でなければ None。
    コードの囲みの行と囲みの中、`<` で始まる項目は、「写す文の整え方」の 4 のとおり捨てる。"""
    rows = lines_of(reply)
    heads = [index for index, row in enumerate(rows) if row.startswith("指摘の一覧:")]
    if len(heads) != 1:
        return None
    found = LIST_HEAD.fullmatch(rows[heads[0]])
    if not found or int(found.group(1)) == 0:
        return None
    items, dropped, state = [], 0, None
    for row in rows[heads[0] + 1:]:
        if not re.match(r"-[ \t]", row):
            break
        touched, state = markup_step(tidy(row[2:], False), state)
        if touched:
            dropped += 1
            continue
        text = tidy(row[2:])
        if text.startswith("<"):
            dropped += 1
            continue
        if text:
            items.append(text if len(text) <= MAX_ITEM_CHARS else text[:MAX_ITEM_CHARS] + "…")
    return int(found.group(1)), items, dropped


def reading(pairs):
    """組の結果と最終レビューの結果（結果, 返事のコメント）から、残した指摘の件数と行、前からある不具合の件数と行を作る。"""
    count, rows, shown, omitted, pre_total, pre_parts, dropped_any = 0, [], 0, 0, 0, [], False
    for result, reply in pairs:
        name = safe_name(result["name"])
        found = PRE_COUNT.search(result["line"])
        if found and int(found.group(1)):
            pre_total += int(found.group(1))
            pre_parts.append(f"{name} {int(found.group(1))} 件")
        if result["mark"] != "warn":
            continue
        listed = finding_list(reply)
        if listed is None:
            count += 1
            rows.append(f"- {name}: 指摘の行を読めない。結果を読む")
            continue
        declared, items, dropped = listed
        dropped_any = dropped_any or dropped > 0
        count += max(declared, len(items) + dropped)
        for text in items:
            if shown < MAX_ITEMS:
                rows.append(f"- {name} {text}")
                shown += 1
            else:
                omitted += 1
        if declared > len(items) + dropped:
            rows.append(f"- {name}: ほか {declared - len(items) - dropped} 件は結果を読む")
    if dropped_any:
        rows.append(f"- {DROPPED}")
    if omitted:
        rows.append(f"- ほか {omitted} 件は各役の結果を読む")
    pre_line = f"前からある不具合: {pre_total} 件" + (f"（{'、'.join(pre_parts)}）" if pre_total else "")
    return {"findings_count": count, "findings": rows, "pre_total": pre_total, "pre_line": pre_line}


def merge(final_round):
    """マージの依頼へ進む。最終レビューの回があれば、その返事が確認したコミットと結論の行も添える。"""
    confirmed, keys, lines, pairs = [], [], [], []
    for entry in results:
        keys.append(key_of.get(entry["id"], entry["id"]))
        lines.append(entry["result"]["line"])
        pairs.append((entry["result"], entry["reply"]))
    for role_id in waited(final_round) if final_round else []:
        reply = latest_reply(final_round, role_id)
        result = parse_result(reply, final_round.get("id"))
        confirmed.append(hex_token(result["commit"]))
        if result["line"] not in lines:
            keys.append(key_of.get(role_id, role_id))
            lines.append(result["line"])
            pairs.append((result, reply))
    emit({"action": "merge", "commit": commit, "confirmed": confirmed, "keys": keys, "lines": lines, "short_path": short_path, **reading(pairs)})


