#!/usr/bin/env bash
# multica-squad-kit-managed
# PR の紐付けを共有する。呼び出し元が source し、警告の文を作る。
# 下の関数を共有する。API の環境の確認と 1 回だけの呼び出し、404 を待つ紐付け、
# 連携なしの記録（置き場所の決め方・読み・作成・消去）である。

# API を呼ぶのに要る環境（トークン・サーバーの URL・curl）がそろっているかを確認する。
# そろっていれば 0、足りなければ理由を PR_LINK_REASON に返して 1。
pr_link_check_api_env() {
	PR_LINK_REASON=''
	if [[ -z ${MULTICA_TOKEN:-} ]]; then
		PR_LINK_REASON='トークンがない'
		return 1
	fi
	if [[ -z ${MULTICA_SERVER_URL:-} ]]; then
		PR_LINK_REASON='サーバーの URL がない'
		return 1
	fi
	if ! command -v curl >/dev/null 2>&1; then
		PR_LINK_REASON='curl がない'
		return 1
	fi
}

# 紐付けの API を 1 回だけ呼ぶ。待ちも再試行もしない。
# pr_link_request_once <タスクの ID> <PR の URL> <curl の時間切れの秒数>
# 状態コードを PR_LINK_STATUS に返す。通信に失敗したときは PR_LINK_STATUS を空にして 1 を返す。
# 呼ぶ前に pr_link_check_api_env を通す。トークンは標準入力だけで curl に渡す。
pr_link_request_once() {
	local id=$1 url=$2 request_timeout=$3
	local -a headers=()
	[[ -z ${MULTICA_WORKSPACE_ID:-} ]] || headers=(-H "X-Workspace-ID: $MULTICA_WORKSPACE_ID")
	PR_LINK_STATUS=''
	# 設定は標準入力だけに渡し、応答本文と curl の診断は捨てる。
	if ! PR_LINK_STATUS=$(printf 'header = "Authorization: Bearer %s"\n' "$MULTICA_TOKEN" |
		curl -q --config - -sS --max-time "$request_timeout" -o /dev/null -w '%{http_code}' \
			-X POST -H 'Content-Type: application/json' ${headers[@]+"${headers[@]}"} \
			--data "$(jq -cn --arg url "$url" '{url:$url}')" \
			"${MULTICA_SERVER_URL%/}/api/issues/$id/pull-requests" 2>/dev/null); then
		PR_LINK_STATUS=''
		return 1
	fi
}

# pr_link_pull_request <タスクの ID> <PR の URL> <metadata の JSON>
# 成功は 0、失敗は 1。理由は PR_LINK_REASON に返し、本文や診断は出さない。
# 期限を過ぎたときだけ PR_LINK_NOT_FOUND に 1 を返し、ほかは 0 にする。
# PR_LINK_ALL_404 は、期限を過ぎ、期限の前の応答がすべて 404 だったときだけ 1 にする。
# 期限の直前の応答が通信の失敗か 404 以外（200 を含む）のときは 0 にする。連携なしの記録の判定は、これだけで行う。
pr_link_pull_request() {
	local id=$1 url=$2 metadata=$3 repository url_repository status started now
	local remaining request_timeout wait_time transport_failed seen_404=0
	local interval=10 timeout=120
	local timeout_reason='サーバーが PR を見つけられない（120 秒待った）'
	PR_LINK_REASON=''
	PR_LINK_NOT_FOUND=0
	PR_LINK_ALL_404=0
	repository=$(jq -r '.repository | select(. != null)' <<<"$metadata") || return 1
	url_repository=${url#https://github.com/}
	url_repository=${url_repository%/pull/*}
	if [[ -n $repository && $(printf '%s' "$repository" | tr '[:upper:]' '[:lower:]') != "$(printf '%s' "$url_repository" | tr '[:upper:]' '[:lower:]')" ]]; then
		PR_LINK_REASON='metadata の repository と違う'
		return 1
	fi
	if jq -e 'has("pr_url")' <<<"$metadata" >/dev/null; then
		return 0
	fi
	pr_link_check_api_env || return 1
	started=$(date +%s)
	while :; do
		now=$(date +%s)
		remaining=$((started + timeout - now))
		if (( remaining <= 0 )); then
			PR_LINK_REASON=$timeout_reason
			PR_LINK_NOT_FOUND=1
			# 次の試みの前に期限を過ぎた。ここへ来るのは 404 のあとの待ちだけで、応答がまだないときは 404 とは言えない。
			PR_LINK_ALL_404=$seen_404
			return 1
		fi
		request_timeout=30
		if (( remaining < request_timeout )); then request_timeout=$remaining; fi
		transport_failed=0
		pr_link_request_once "$id" "$url" "$request_timeout" || transport_failed=1
		status=$PR_LINK_STATUS
		# 期限後の応答は、状態コードが 200 でも成功として扱わない。
		now=$(date +%s)
		remaining=$((started + timeout - now))
		if (( remaining <= 0 )); then
			PR_LINK_REASON=$timeout_reason
			PR_LINK_NOT_FOUND=1
			if (( ! transport_failed )) && [[ $status == 404 ]]; then PR_LINK_ALL_404=1; fi
			return 1
		fi
		if (( transport_failed )); then
			PR_LINK_REASON='通信に失敗した'
			return 1
		fi
		case "$status" in
		200)
			if multica issue metadata set "$id" --key pr_url --value "$url" --type string >/dev/null 2>&1; then
				return 0
			fi
			PR_LINK_REASON='metadata を書けない'
			return 1
			;;
		404)
			seen_404=1
			wait_time=$interval
			if (( remaining < wait_time )); then wait_time=$remaining; fi
			sleep "$wait_time"
			;;
		*)
			PR_LINK_REASON="応答の状態コード $status"
			return 1
			;;
		esac
	done
}

# 連携なしの記録。ホストのエージェントのホームの下に、プロジェクトとリポジトリごとに 1 つのファイルで置く。
# ファイルがあることだけを「連携なし」と読み、中身は人間が読むためだけに書く（docs/pr-link-no-integration.md）。
# 置き場所: ${PR_LINK_STATE_ROOT:-$HOME/.multica-agent/template/pr-link}/<プロジェクトの ID>/<オーナー>/<リポジトリ>
# 関数は理由を PR_LINK_RECORD_REASON に返す。標準出力には何も出さない。

# パスの 1 つの部分を検査する。空・`.`・`..`・英数字と `_.-` 以外を含むものは断って 1 を返す。
pr_link_record_part_ok() {
	case $1 in
	'' | . | .. | *[!A-Za-z0-9_.-]*) return 1 ;;
	esac
}

# pr_link_record_locate <プロジェクトの ID> <PR の URL>
# 記録のパスを PR_LINK_RECORD、その上のディレクトリを PR_LINK_RECORD_DIR（オーナーまで）と PR_LINK_RECORD_PROJECT_DIR に返す。
# オーナーとリポジトリは URL から取って小文字にする。部分が検査を通らないときは、理由を返して 1 を返す。
pr_link_record_locate() {
	local project=$1 url=$2 root path owner repository
	PR_LINK_RECORD='' PR_LINK_RECORD_DIR='' PR_LINK_RECORD_PROJECT_DIR='' PR_LINK_RECORD_REASON=''
	path=${url#https://github.com/}
	path=${path%/pull/*}
	owner=$(printf '%s' "${path%%/*}" | tr '[:upper:]' '[:lower:]')
	repository=$(printf '%s' "${path#*/}" | tr '[:upper:]' '[:lower:]')
	if ! pr_link_record_part_ok "$project" || ! pr_link_record_part_ok "$owner" || ! pr_link_record_part_ok "$repository"; then
		PR_LINK_RECORD_REASON='連携なしの記録のパスに使えない文字がある'
		return 1
	fi
	root=${PR_LINK_STATE_ROOT:-${HOME:-}/.multica-agent/template/pr-link}
	PR_LINK_RECORD_PROJECT_DIR=$root/$project
	PR_LINK_RECORD_DIR=$root/$project/$owner
	PR_LINK_RECORD=$root/$project/$owner/$repository
}

# 記録のパスの上のディレクトリと記録が、シンボリックリンクでも、記録が普通のファイルでないものでもないかを検査する。
# 通れば 0、通らなければ理由を返して 1。ないものは通す。
pr_link_record_safe() {
	if [[ -L $PR_LINK_RECORD_PROJECT_DIR || -L $PR_LINK_RECORD_DIR || -L $PR_LINK_RECORD ]]; then
		PR_LINK_RECORD_REASON='連携なしの記録のパスにシンボリックリンクがあるため、記録はないものとして扱う'
		return 1
	fi
	if [[ -e $PR_LINK_RECORD && ! -f $PR_LINK_RECORD ]]; then
		PR_LINK_RECORD_REASON='連携なしの記録のパスが普通のファイルでないため、記録はないものとして扱う'
		return 1
	fi
}

# pr_link_record_exists <プロジェクトの ID> <PR の URL>
# 記録があれば 0、なければ 1。パスの検査やシンボリックリンクで断ったときも「ない」として 1 を返し、
# 標準エラーに理由を 1 行だけ出す。ただのないときは何も出さない。
pr_link_record_exists() {
	if ! pr_link_record_locate "$1" "$2" || ! pr_link_record_safe; then
		printf '%s\n' "$PR_LINK_RECORD_REASON" >&2
		return 1
	fi
	[[ -f $PR_LINK_RECORD ]]
}

# pr_link_record_create <プロジェクトの ID> <PR の URL> <タスクの識別子>
# 記録を作る。ディレクトリは 700、ファイルは 600 で作る。ファイルは同じディレクトリの一時ファイルに書き、
# `ln` で記録のパスに結ぶ。`ln` は記録のパスがあると失敗するので、同時に作る実行のうち 1 つだけが作れる。
# 作れたら 0 を返し、一時ファイルを PR_LINK_RECORD_TMP に残す（あとで pr_link_record_discard_own か
# pr_link_record_finish で消す）。すでにあれば 2、ほかの理由で作れなければ 1 を返し、どちらも一時ファイルを残さない。
# 理由は PR_LINK_RECORD_REASON に返す。パスの検査やシンボリックリンクで断ったときだけ、標準エラーに理由を 1 行出す。
pr_link_record_create() {
	local project=$1 url=$2 identifier=$3 repository tmp
	PR_LINK_RECORD_TMP=''
	if ! pr_link_record_locate "$project" "$url" || ! pr_link_record_safe; then
		printf '%s\n' "$PR_LINK_RECORD_REASON" >&2
		return 1
	fi
	if [[ -e $PR_LINK_RECORD ]]; then
		PR_LINK_RECORD_REASON='連携なしの記録がすでにある'
		return 2
	fi
	if ! (umask 077 && mkdir -p -- "$PR_LINK_RECORD_DIR") 2>/dev/null; then
		PR_LINK_RECORD_REASON='連携なしの記録のディレクトリを作れない'
		return 1
	fi
	# ディレクトリを作ったあとに、置き換えられていないかをもう一度見る。
	if ! pr_link_record_safe; then
		printf '%s\n' "$PR_LINK_RECORD_REASON" >&2
		return 1
	fi
	chmod -- 700 "$PR_LINK_RECORD_PROJECT_DIR" "$PR_LINK_RECORD_DIR" 2>/dev/null || true
	repository=${PR_LINK_RECORD_DIR#"$PR_LINK_RECORD_PROJECT_DIR"/}/${PR_LINK_RECORD##*/}
	if ! tmp=$(umask 077 && mktemp "$PR_LINK_RECORD_DIR/.record.XXXXXX" 2>/dev/null); then
		PR_LINK_RECORD_REASON='連携なしの記録の一時ファイルを作れない'
		return 1
	fi
	if ! {
		printf 'repository: %s\n' "$repository"
		printf 'pr: %s\n' "$url"
		printf 'task: %s\n' "$identifier"
		printf '記録した時刻: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	} >"$tmp" 2>/dev/null || ! chmod -- 600 "$tmp" 2>/dev/null; then
		rm -f -- "$tmp"
		PR_LINK_RECORD_REASON='連携なしの記録を書けない'
		return 1
	fi
	if ! ln -- "$tmp" "$PR_LINK_RECORD" 2>/dev/null; then
		rm -f -- "$tmp"
		if [[ -e $PR_LINK_RECORD || -L $PR_LINK_RECORD ]]; then
			PR_LINK_RECORD_REASON='連携なしの記録がすでにある'
			return 2
		fi
		PR_LINK_RECORD_REASON='連携なしの記録を結べない'
		return 1
	fi
	PR_LINK_RECORD_TMP=$tmp
}

# 自分が作った記録の一時ファイルを消す。pr_link_record_create が 0 を返したあと、最後に呼ぶ。
pr_link_record_finish() {
	[[ -z ${PR_LINK_RECORD_TMP:-} ]] || rm -f -- "$PR_LINK_RECORD_TMP"
	PR_LINK_RECORD_TMP=''
}

# 自分が作った記録だけを消し、一時ファイルも消す。記録のパスが自分の一時ファイルと同じファイル（-ef）のときだけ、記録を消す。
# ほかの実行が作った記録は消さない。pr_url を書けなかったときに使う。
pr_link_record_discard_own() {
	if [[ -n ${PR_LINK_RECORD_TMP:-} && -f $PR_LINK_RECORD && ! -L $PR_LINK_RECORD && $PR_LINK_RECORD -ef $PR_LINK_RECORD_TMP ]]; then
		rm -f -- "$PR_LINK_RECORD"
	fi
	pr_link_record_finish
}

# pr_link_record_remove <プロジェクトの ID> <PR の URL>
# 記録を消す。PR が紐付いたと分かったときに使う。消せたら 0、ないときや断ったときは 1 を返す。
# パスの検査やシンボリックリンクで断ったときは、書きも消しもせず、標準エラーに理由を 1 行だけ出す。
pr_link_record_remove() {
	if ! pr_link_record_locate "$1" "$2" || ! pr_link_record_safe; then
		printf '%s\n' "$PR_LINK_RECORD_REASON" >&2
		return 1
	fi
	[[ -f $PR_LINK_RECORD ]] || return 1
	rm -f -- "$PR_LINK_RECORD" 2>/dev/null
}
