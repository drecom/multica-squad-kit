#!/usr/bin/env bash
# multica-squad-kit-managed
# Multica のエージェントの実行で、git の HTTPS の認証情報を、ワークスペースに紐付いたリポジトリにだけ渡すヘルパー。
# git の credential.https://github.com.helper に置く（useHttpPath=true で、リポジトリのパスを受け取る）。
# 許すリポジトリは gh のガードと同じく、SQUAD_KIT_ALLOWED_REPOS、未設定ならホストの既定のファイルから読む。
# 答えるのは、get の問い合わせで、github.com の HTTPS の許すリポジトリで、親のプロセスに git-remote-https があるときだけ。
# git credential fill で人のトークンを取り出せないようにするため。どれかに合わないときは、何も返さずに終わる。
# 答えるときは、人の gh の置き場（SQUAD_KIT_GH_CONFIG_DIR）で、本物の gh の auth git-credential get を呼ぶ。
# macOS の bash 3.2 でも動くよう、連想配列は使わない。
set -euo pipefail

ALLOWED_FILE=${SQUAD_KIT_ALLOWED_REPOS:-$HOME/.multica-agent/allowed-repos}

[[ ${1:-} == get ]] || exit 0

# 親のプロセスをたどり、git-remote-https があるか見る。
# macOS の comm は実行ファイルのパス、Linux の comm は 15 文字で切れるので、args の先頭の語を見る。
has_remote_https_ancestor() {
	local pid=$PPID depth=0 name
	while [[ $pid =~ ^[0-9]+$ ]] && (( pid > 1 && depth < 16 )); do
		name=$(ps -o args= -p "$pid" 2>/dev/null || true)
		name=${name# }
		name=${name%% *}
		[[ ${name##*/} != git-remote-https ]] || return 0
		pid=$(ps -o ppid= -p "$pid" 2>/dev/null || true)
		pid=${pid//[[:space:]]/}
		depth=$((depth + 1))
	done
	return 1
}

# PATH から、キットのガードではない本物の gh を探す。ガードは先頭の行のマークで見分ける。
real_gh() {
	local dir
	local IFS=:
	for dir in $PATH; do
		if [[ -n $dir && -x $dir/gh ]] && ! head -c 512 "$dir/gh" 2>/dev/null | grep -aq 'multica-squad-kit-managed'; then
			echo "$dir/gh"
			return
		fi
	done
	return 1
}

input=$(cat)
protocol=
host=
path=
while IFS='=' read -r key value || [[ -n $key ]]; do
	case $key in
	protocol) protocol=$value ;;
	host) host=$value ;;
	path) path=$value ;;
	esac
done <<<"$input"

[[ $protocol == https && $host == github.com ]] || exit 0
[[ $path =~ ^([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)$ ]] || exit 0
repo="${BASH_REMATCH[1]}/${BASH_REMATCH[2]%.git}"
[[ -f $ALLOWED_FILE ]] && grep -qxiF -- "$repo" "$ALLOWED_FILE" || exit 0
has_remote_https_ancestor || exit 0
gh=$(real_gh) || exit 0

if [[ -n ${SQUAD_KIT_GH_CONFIG_DIR:-} ]]; then
	export GH_CONFIG_DIR=$SQUAD_KIT_GH_CONFIG_DIR
fi
exec "$gh" auth git-credential get <<<"$input"
