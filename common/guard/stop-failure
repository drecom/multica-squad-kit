#!/usr/bin/env python3
# multica-squad-kit-managed
"""Multica のエージェントの実行が、API の失敗で終わった理由を残すフック（StopFailure）。

Claude Code が、標準入力に JSON で StopFailure の入力を渡す。
  1. MULTICA_TASK_ID がない実行（人が端末で使う Claude Code など）は、何もせずに終わる
  2. 入力の hook_event_name が StopFailure で、error が 13 の値のどれかなら、その値を理由にする。知らない値は unknown にする
  3. 状態の置き場（SQUAD_KIT_STATE_DIR。なければこのスクリプトと同じディレクトリの state/）の
     run-stops/<年>-<月>.jsonl に、理由の行を 1 行足す

入力の last_assistant_message は、モデルの出力で作業先の内容を含みうるので、読まず、記録にも写さない。
置き場は権限 700、ファイルは 600 にし、1 行を 1 回の書き込みで足す。run-stops とその中の記録のファイルは、シンボリックリンクをたどらずに
確認したディレクトリを起点に開き、すでにあるものは、種類（ディレクトリか通常のファイル）・持ち主・権限（グループと他人になし）が合うときだけ使う。
合わないとき、書けないとき、入力を読めないときは、何も出さずに 0 で終わる。記録の失敗で、実行の終わり方を変えないため。
"""
import json
import os
import stat
import sys
import time

sys.dont_write_bytecode = True

HERE = os.path.dirname(os.path.realpath(__file__))
INPUT_LIMIT = 8 * 1024 * 1024
# StopFailure の error の値（docs/agent-run-stops.md「記録の形」の表）。これ以外は unknown にする
KNOWN_REASONS = frozenset((
    "authentication_failed", "oauth_org_not_allowed", "account_on_hold", "verification_required",
    "cloud_credential_error", "rate_limit", "billing_error", "overloaded", "server_error",
    "invalid_request", "model_not_found", "max_output_tokens", "unknown",
))


def state_dir():
    return os.environ.get("SQUAD_KIT_STATE_DIR") or os.path.join(HERE, "state")


def open_checked_dir(parent_fd, name, create):
    """parent_fd を起点に、シンボリックリンクをたどらずにディレクトリを開く。ないときは create なら権限 700 で作る。
    ディレクトリで、このフックを動かす利用者の持ち物で、グループと他人に権限がないときだけ使い、合わなければ OSError にする。"""
    flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(name, flags, dir_fd=parent_fd)
    except FileNotFoundError:
        if not create:
            raise
        os.mkdir(name, 0o700, dir_fd=parent_fd)
        fd = os.open(name, flags, dir_fd=parent_fd)
    try:
        check_owned(os.fstat(fd), stat.S_ISDIR)
    except OSError:
        os.close(fd)
        raise
    return fd


def check_owned(info, kind):
    if not kind(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077:
        raise OSError("置き場の種類・持ち主・権限が合わない")


def append_record(record, now):
    """run-stops/<年>-<月>.jsonl に、1 行を 1 回の書き込みで足す。置き場かファイルが合わなければ OSError にする。"""
    old_umask = os.umask(0o077)
    try:
        os.makedirs(state_dir(), mode=0o700, exist_ok=True)
        state_fd = os.open(state_dir(), os.O_RDONLY | os.O_DIRECTORY)
        try:
            dir_fd = open_checked_dir(state_fd, "run-stops", True)
        finally:
            os.close(state_fd)
        try:
            flags = os.O_WRONLY | os.O_APPEND | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
            fd = os.open(time.strftime("%Y-%m", now) + ".jsonl", flags, 0o600, dir_fd=dir_fd)
            try:
                check_owned(os.fstat(fd), stat.S_ISREG)
                os.write(fd, (json.dumps(record, ensure_ascii=True) + "\n").encode("ascii"))
            finally:
                os.close(fd)
        finally:
            os.close(dir_fd)
    finally:
        os.umask(old_umask)


def main():
    task_id = os.environ.get("MULTICA_TASK_ID", "")
    if not task_id:
        return 0
    try:
        stop_input = json.loads(sys.stdin.buffer.read(INPUT_LIMIT).decode("utf-8"))
    except (ValueError, OSError):
        return 0
    if not isinstance(stop_input, dict) or stop_input.get("hook_event_name") != "StopFailure":
        return 0

    error = stop_input.get("error")
    reason = error if isinstance(error, str) and error in KNOWN_REASONS else "unknown"
    session = stop_input.get("session_id")
    now = time.gmtime()
    record = {
        "time": time.strftime("%Y-%m-%dT%H:%M:%SZ", now),
        "task": task_id,
        "agent": os.environ.get("MULTICA_AGENT_ID", ""),
        "session": session if isinstance(session, str) else "",
        "reason": reason,
        "source": "claude",
    }
    try:
        append_record(record, now)
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
