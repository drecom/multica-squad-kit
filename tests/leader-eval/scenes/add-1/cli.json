      ]
    },
    {
      "match": "multica issue pull-requests issue-shop-1",
      "stdout": {
        "pull_requests": []
      }
    },
    {
      "match": "multica issue runs issue-shop-1",
      "stdout": []
    },
    {
      "match": "squad-usage-wait pick issue-shop-1 principal",
      "stdout": "役: codex-principal\n振り分け: Codex。Claude 週 20%、Codex 週 30%"
    },
    {
      "match": "squad-review-wait status issue-shop-1",
      "stdout": "返事の待ち: 登録なし"
    },
    {
      "match": "squad-review-next decide issue-shop-1",
      "stdout": "次の依頼を決められません: 要件の見直しの回はリーダーが扱う",
      "exit": 3
