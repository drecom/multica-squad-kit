{
  "commands": [
    {
      "match": "squad-preflight",
      "stdout": "squad-preflight: ガードの gh と、すべての見張りが使えます。"
    },
    {
      "match": "multica issue --help",
      "stdout": "Usage: multica issue <command>\n\nCommands:\n  get, list, search, create, comment, status, assign, update, pull-requests, runs, run-messages, cancel-task, rerun, label, metadata\n\n`multica issue pull-requests <id>` lists the pull requests linked to an issue. There is no command that links a pull request."
    },
    {
      "match": "multica issue label list issue-shop-1",
      "stdout": "[]"
    },
    {
      "match": "multica label list",
      "stdout": "[\n  {\n    \"id\": \"label-important\",\n    \"name\": \"重要\"\n  },\n  {\n    \"id\": \"label-dev\",\n    \"name\": \"開発\"\n  },\n  {\n    \"id\": \"label-ops\",\n    \"name\": \"運用\"\n  },\n  {\n    \"id\": \"label-instruction\",\n    \"name\": \"指示の改善\"\n  },\n  {\n    \"id\": \"label-qa\",\n    \"name\": \"検証\"\n  }\n]"
    },
    {
      "match": "multica issue children issue-shop-1",
      "stdout": "[]"
    },
    {
      "match": "multica repo list",
      "stdout": "[\n  {\n    \"url\": \"https://github.com/example/shop\"\n  }\n]"
    },
    {
      "match": "squad-review-wait watch issue-shop-1",
      "stdout": "返事の待ちの見張りを入れました。"
    },
    {
      "match": "squad-review-wait proceed issue-shop-1",
      "stdout": "返事の待ち: 次に進む"
    },
    {
      "match": "multica agent get agent-designer",
      "stdout": {
        "id": "agent-designer",
        "name": "shop-designer-member1",
        "model": "gpt-6.1-sol"
      }
    },
    {
      "match": "multica issue get issue-shop-1",
      "stdout": {
        "id": "issue-shop-1",
        "identifier": "SHOP-1",
        "title": "カートに商品数を出す",
        "status": "in_progress",
        "assignee_type": "squad",
        "assignee_id": "squad-shop",
        "project_id": "project-shop",
        "labels": [],
        "metadata": {
          "repository": "example/shop"
        },
        "description": "## 背景\nカートの商品数をすぐ確認したい。\n\n## 要件\nカートのアイコンに商品の数を表示する。\n\n## やらないこと\nカートの中身の編集は変えない。\n\n## 受け入れ条件\n100 以上は 99+ と表示する。"
      }
    },
    {
      "match": "squad-task-read issue-shop-1",
      "stdout": {
        "schema_version": 1,
        "task": {
          "id": "issue-shop-1",
          "identifier": "SHOP-1",
          "title": "カートに商品数を出す",
          "status": "in_progress",
          "labels": [],
          "metadata": {
            "repository": "example/shop"
          },
          "assignee_type": "squad",
          "assignee_id": "squad-shop"
        },
        "comments": [
          {
            "id": "comment-2",
            "parent_id": null,
            "author_type": "member",
            "author_id": "member1",
            "created_at": "2026-01-10T09:00:00Z",
            "content": "要件と受け入れ条件を本文に書きました。設計をお願いします。"
          }
        ],
        "pr": null,
        "ci": null,
        "runs": [],
        "cuts": [],
        "errors": []
      }
    },
    {
      "match": "multica issue comment list issue-shop-1",
      "stdout": [
        {
          "id": "comment-2",
          "author_type": "member",
          "author_id": "member1",
          "content": "要件と受け入れ条件を本文に書きました。設計をお願いします。",
